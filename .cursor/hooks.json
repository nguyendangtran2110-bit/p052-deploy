{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "bash \"$(git rev-parse --show-toplevel)/scripts/log_cursor_hook.sh\" --tool=codex",
        "commandWindows": "$root = git rev-parse --show-toplevel; & bash \"$root\\scripts\\log_cursor_hook.sh\" --tool=codex"
      }
    ],
    "stop": [
      {
        "command": "bash \"$(git rev-parse --show-toplevel)/scripts/log_cursor_hook.sh\" --tool=codex",
        "commandWindows": "$root = git rev-parse --show-toplevel; & bash \"$root\\scripts\\log_cursor_hook.sh\" --tool=codex"
      }
    ]
  }
}
