# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
GROQ_API_KEY=
LLAMA_MODEL=llama-3.1-8b-instant

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://onbxrd:onbxrd@localhost:5432/onbxrd
# For SQLite (development):
# DATABASE_URL=sqlite+aiosqlite:///./data/app.db
DATABASE_ECHO=false
AUTO_CREATE_TABLES=true

# ---- Knowledge Base ----
KNOWLEDGE_STORAGE_DIR=./data/handbooks
HANDBOOK_CONTEXT_FILE=./data/handbook1.md
HANDBOOK_CHUNK_MAX_CHARS=4500
HANDBOOK_CONTEXT_TOP_K=5
HANDBOOK_CONTEXT_MIN_SCORE=1.5
MAX_UPLOAD_BYTES=20971520
EMBEDDING_DIMENSIONS=1536

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DEV_AUTH_ENABLED=false

# ---- Authentication ----
# Generate unique secrets for each environment. Never use these placeholders in production.
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=onbxrd-api
JWT_AUDIENCE=onbxrd-clients
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
# Required only to create the very first management administrator.
MANAGEMENT_BOOTSTRAP_TOKEN=replace-with-a-one-time-bootstrap-secret
PASSWORD_RESET_TOKEN_MINUTES=15
PASSWORD_RESET_URL_BASE=http://localhost:3000/reset-password
EMAIL_VERIFICATION_TOKEN_MINUTES=10
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_SENDS=3
EMAIL_VERIFICATION_MAX_IP_SENDS=10
EMAIL_VERIFICATION_WINDOW_MINUTES=15

# ---- SMTP (password reset) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# ---- AWS S3 (private attachment bucket) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
S3_PRESIGNED_URL_EXPIRE_SECONDS=900
ATTACHMENT_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=f3p1dEOhD_z8qjjtbeCtb2t9ASMEliz-4juZfWe3ZPgCtPZp-LjWthBfeNU8d5dP
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
