# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration (OpenAI primary, Qwen fallback) ----
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.1
# Optional Qwen fallback and embedding provider
QWEN_API_KEY=your-qwen-api-key-here
QWEN_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
CHAT_ALLOW_ANONYMOUS=false
CHAT_RATE_LIMIT_ENABLED=true
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_RATE_LIMIT_ANONYMOUS_REQUESTS=20
CHAT_RATE_LIMIT_AUTHENTICATED_REQUESTS=60
CHAT_OUTPUT_MAX_CHARS=8000
# Backup chat model used when OpenAI is unavailable
QWEN_MODEL_NAME=qwen3.5-plus
EMBEDDING_MODEL_NAME=text-embedding-v4
# Leave empty to keep Groq disabled. It is the last fallback when configured.
GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://onbxrd:onbxrd@localhost:5432/onbxrd
# For SQLite (development):
# DATABASE_URL=sqlite+aiosqlite:///./data/app.db
DATABASE_ECHO=false
AUTO_CREATE_TABLES=true

# ---- Knowledge Base & RAG ----
KNOWLEDGE_STORAGE_DIR=./data/handbooks
CHROMA_PERSIST_DIR=./data/chroma
# Empty means use the processed ingestion files in data/processed/*.md
HANDBOOK_CONTEXT_FILE=
HANDBOOK_CHUNK_MAX_CHARS=4500
HANDBOOK_CONTEXT_TOP_K=5
HANDBOOK_CONTEXT_MIN_SCORE=1.5
MAX_UPLOAD_BYTES=20971520
EMBEDDING_DIMENSIONS=1536

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DEV_AUTH_ENABLED=false

# ---- Authentication ----
# Generate unique secrets for each environment. Never use these placeholders in production.
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=onbxrd-api
JWT_AUDIENCE=onbxrd-clients
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
# Required only to create the very first management administrator.
MANAGEMENT_BOOTSTRAP_TOKEN=replace-with-a-one-time-bootstrap-secret
PASSWORD_RESET_TOKEN_MINUTES=15
PASSWORD_RESET_URL_BASE=http://localhost:3000/reset-password
EMAIL_VERIFICATION_TOKEN_MINUTES=10
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_SENDS=3
EMAIL_VERIFICATION_MAX_IP_SENDS=10
EMAIL_VERIFICATION_WINDOW_MINUTES=15

# ---- SMTP (password reset) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# ---- AWS S3 (private attachment bucket) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
S3_PRESIGNED_URL_EXPIRE_SECONDS=900
ATTACHMENT_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=replace-with-a-fake-local-placeholder
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
