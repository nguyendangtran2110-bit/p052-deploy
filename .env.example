# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration (Qwen / DashScope) ----
QWEN_API_KEY=your-qwen-api-key-here
QWEN_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
GROQ_API_KEY=your-groq-api-key-here
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_MODEL_NAME=llama-3.3-70b-versatile
# OCR model used by scripts/ingest_handbook.py
MODEL_NAME=qwen3.6-plus
# Backup chat model used when Groq is unavailable
QWEN_MODEL_NAME=qwen3.5-plus
EMBEDDING_MODEL_NAME=text-embedding-v4

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=replace-with-a-fake-local-placeholder
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
