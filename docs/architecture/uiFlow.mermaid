graph TD
    Landing["<b>Landing</b><br/>Boomerang product entry"]
    Onboarding["<b>Onboarding tab</b><br/>Step-by-step checklist + chatbot"]
    Zalo["<b>Demo Zalo chat</b><br/>30 Vietnamese mock messages"]
    Summary["<b>Agent summary</b><br/>Important signals + 800 unread"]
    Detect["<b>Rule-based detection</b><br/>nước · điện · cháy · nứt · hỏng"]
    Prompt["<b>Create ticket prompt</b><br/>Resident confirms"]
    Ticket["<b>Ticket tab</b><br/>Resident / Management role"]
    Verify["<b>Resident verify</b><br/>Prefilled fields + submit"]
    Queue["<b>Management queue</b><br/>Review classification + priority"]
    HITL["<b>HITL approval</b><br/>Approve / reject"]
    Status["<b>Ticket status</b><br/>Submitted → Approved → In progress → Resolved"]

    Landing --> Onboarding
    Landing --> Zalo
    Landing --> Ticket
    Onboarding --> Ticket
    Zalo --> Summary
    Zalo --> Detect
    Detect --> Prompt
    Prompt -->|Có| Ticket
    Prompt -->|Để sau| Zalo
    Ticket --> Verify
    Ticket --> Queue
    Verify --> Queue
    Queue --> HITL
    HITL --> Status

    classDef marketing fill:#F7F5F0,stroke:#D1D5DB,stroke-width:1px,color:#2D3748;
    class Landing marketing;
    classDef resident fill:#E6F6F4,stroke:#A3E4D7,stroke-width:1px,color:#166534;
    class Onboarding,Zalo,Verify resident;
    classDef agent fill:#F4F3F3,stroke:#D1D5DB,stroke-width:1px,color:#374151;
    class Summary,Detect,Prompt agent;
    classDef management fill:#FDF2F0,stroke:#FADBD8,stroke-width:1px,color:#991B1B;
    class Ticket,Queue,HITL,Status management;
