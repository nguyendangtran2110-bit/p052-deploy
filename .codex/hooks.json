{
  "description": "Ghi Codex prompts vào AI tracking log.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/_pyrun.sh\" \"$(git rev-parse --show-toplevel)/scripts/log_hook.py\" --tool=codex",
            "commandWindows": "$root = git rev-parse --show-toplevel; & \"$root\\.venv\\Scripts\\python.exe\" \"$root\\scripts\\log_hook.py\" --tool=codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/_pyrun.sh\" \"$(git rev-parse --show-toplevel)/scripts/log_hook.py\" --tool=codex",
            "commandWindows": "$root = git rev-parse --show-toplevel; & \"$root\\.venv\\Scripts\\python.exe\" \"$root\\scripts\\log_hook.py\" --tool=codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
